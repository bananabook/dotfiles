set recolor

map <C-+> zoom in
map <C--> zoom out

map w zoom out
map e zoom in

map u navigate next
map i navigate previous

map b toggle_statusbar
map z set recolor

#map y set first-page-column 1
#map x :set first-page-column 2

set recolor-lightcolor \#000000
set recolor-darkcolor \#FFFFFF

set default-bg \#000000
set default-fg \#D0D0D0

set statusbar-bg \#000000
set statusbar-fg \#D0D0D0

set inputbar-bg \#000000
set inputbar-fg \#D0D0D0

set notification-bg \#000000
set notification-fg \#D0D0D0

set highlight-color \#FF0000
set highlight-active-color \#33FF00

set recolor-keephue
#set recolor-reverse-video

set selection-clipboard clipboard

set window-title-page true
set page-cache-size 100

set guioptions none
